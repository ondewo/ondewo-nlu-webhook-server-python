## Common Patterns

### Custom Integration Pattern
```python
@Timer(logger=log.debug, log_arguments=True)
async def slot_filling(
    active_intent: Intent,
    active_contexts: list[Context] | None = None,
    headers: dict[str, str] | None = None,
) -> list[Context] | None:
    """Process slot filling request."""

    # Check if intent is active
    if active_intent.display_name not in active_intents:
        log.debug(f"Intent not in active list: {active_intent.display_name}")
        return active_contexts

    # Process based on intent
    match active_intent.display_name:
        case IntentMapping.I_EXAMPLE_MY_DATE.value:
            return await handle_date_intent(active_contexts)
        case _:
            log.warning(f"No handler for intent: {active_intent.display_name}")
            return active_contexts
```

